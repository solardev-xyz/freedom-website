[Unit]
Description=Re-push the freedombrowser.eth site to Swarm (keeps the site and its feed retrievable)
Documentation=https://github.com/freedom-hq/ant/issues/87
After=network-online.target antd.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/freedom-website
Environment=PATH=/home/ubuntu/node/bin:/usr/local/bin:/usr/bin:/bin
# --expect-feed re-pushes the content and the feed chunks, and fails loudly
# if dist/ no longer matches what the feed points at instead of publishing it.
ExecStart=/home/ubuntu/node/bin/node scripts/deploy-swarm.js --expect-feed
